{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tiny Time Tool",
  "version": "0.1.0",
  "identifier": "com.gocadre.tinytimetool",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tiny Time Tool",
        "width": 800,
        "height": 600
      },
      {
        "label": "panel",
        "title": "Quick Entry",
        "url": "index.html",
        "width": 480,
        "height": 160,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "center": true,
        "visible": false,
        "skipTaskbar": true,
        "focus": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
