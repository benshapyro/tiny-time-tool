{
  "csp": "default-src 'self'",
  "capabilities": [
    {
      "identifier": "default",
      "windows": ["main"],
      "remote": null,
      "permissions": [
        "core:default",
        "opener:default",
        "sql:default",
        "sql:allow-execute",
        "global-shortcut:allow-register",
        "global-shortcut:allow-unregister"
      ]
    }
  ]
}
